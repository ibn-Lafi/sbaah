{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter=@sbaah/dashboard build",
    "watchPatterns": ["apps/dashboard/**", "packages/shared/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter=@sbaah/dashboard exec next start -p $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
