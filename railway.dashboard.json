{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter=@sbaah/dashboard build",
    "watchPatterns": ["apps/dashboard/**", "packages/shared/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "turbo.json", "railway.dashboard.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter=@sbaah/dashboard exec next start -p $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
