# Supabase — api is the only service with a direct connection (PRODUCT_SPEC section 7)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role: used ONLY for the narrow server-side paths that must run
# before a user JWT exists (pre-auth OTP send/verify, registration, password
# reset — see docs/OTP_FLOW.md) and for explicit console-triggered
# cross-tenant operations. Never expose this to dashboard/console/public-site
# directly.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback-only: manual JWT signing if the admin.generateLink + verifyOtp
# session-minting approach (docs/OTP_FLOW.md section 4) doesn't hold up
# against a real project. Not used unless that fallback is implemented.
SUPABASE_JWT_SECRET=

# Authentica — OTP SMS provider (PRODUCT_SPEC section 2), no fallback
# provider. Unlike Twilio Verify, Authentica does not generate the code
# itself — api generates it (lib/otp/generate-code.ts) and Authentica only
# delivers + stores it for the matching /verify-otp check. Get your key at
# https://portal.authentica.sa/applications/ — see docs/OTP_FLOW.md.
AUTHENTICA_API_KEY=
# Optional — a custom SMS template configured in the Authentica portal.
# Omit to use their default sender-name template.
AUTHENTICA_OTP_TEMPLATE_ID=

# Signs the short-lived (10 min) token that bridges a successful OTP verify
# to registration/reset-password (docs/OTP_FLOW.md sections 4-5). Generate
# with e.g. `openssl rand -base64 32` — any long random string, unrelated
# to SUPABASE_JWT_SECRET above.
AUTH_TEMP_TOKEN_SECRET=

# SNDR — transactional email. Get your key from app.sndr.sh/settings/api-keys.
# SNDR_FROM_EMAIL must be an address on a domain verified in SNDR
# (app.sndr.sh domains). Used for every outbound email this app sends —
# team-invite notifications, new-lead-assigned alerts to agents, and OTP
# codes sent by email (login / reset password) — see lib/email/send.ts.
SNDR_API_KEY=
SNDR_FROM_EMAIL=

# HMAC secret used to hash email-OTP codes before storing them in
# otp_verifications (lib/otp/hash-email-code.ts). Unlike SMS OTP, which
# Authentica itself verifies remotely, an email-OTP code is generated and
# checked entirely by us, so nothing but this hash is ever persisted.
# Generate with e.g. `openssl rand -base64 32`.
OTP_EMAIL_CODE_SECRET=

# StreamPay — payment gateway (PRODUCT_SPEC section 2)
# The "إنشاء مفتاح API" screen in StreamPay's dashboard shows 3 fields —
# "مفتاح API", "المفتاح السري", and "x-api-key". Copy the THIRD field
# ("x-api-key") verbatim here — it is StreamPay's own pre-computed
# base64("مفتاح API:المفتاح السري"), sent as-is in the x-api-key header
# (see streampay-client.ts's file comment). Do not copy the first field
# alone and do not re-encode it yourself.
STREAMPAY_API_KEY=
# Separate credential from a "Webhooks" section of StreamPay's dashboard
# (not the API-key screen above) — confirm its exact location with them.
STREAMPAY_WEBHOOK_SECRET=

# dashboard's own base URL (no trailing slash) — checkout/route.ts builds
# StreamPay's success/failure redirect URLs from this
# (`${DASHBOARD_APP_URL}/billing?checkout=success|cancelled`). Was
# missing from this file entirely before (never documented for Railway),
# which meant every checkout attempt failed immediately with "Missing
# required environment variable" before ever reaching StreamPay.
DASHBOARD_APP_URL=

# CORS allowlist for authenticated endpoints (PRODUCT_SPEC section 7)
# Comma-separated origins for dashboard and console. Public-site
# domains are NOT listed here — /public/* endpoints accept any origin.
API_CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# Cloudflare for SaaS / Custom Hostnames (apps/api/src/lib/tenant/cloudflare-api-client.ts)
# — this is what actually registers a customer's custom domain, so Cloudflare
# issues it a real certificate and routes it to the public-site Railway
# service once DNS is pointed correctly (PRODUCT_SPEC section 4.3). Replaces
# the earlier direct-Railway-registration approach, which hit Railway's own
# "custom domains per service" plan limit (Hobby: 2, Pro: 20) — incompatible
# with every tenant wanting their own domain on the same Railway service.
# CLOUDFLARE_API_TOKEN: a Zone-scoped API token (My Profile → API Tokens →
# Create Custom Token) with "Zone → SSL and Certificates → Edit" permission,
# restricted to PLATFORM_ROOT_DOMAIN's own zone.
# CLOUDFLARE_ZONE_ID: PLATFORM_ROOT_DOMAIN's zone id, from that zone's
# Overview page in the Cloudflare dashboard (right-hand "API" panel).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# The fixed CNAME target every tenant's custom domain points at — same value
# for every tenant, unlike the old per-domain Railway target (Cloudflare
# routes by matching the incoming Host header against the registered Custom
# Hostname, not by where the CNAME itself resolves). This must already exist
# as a *proxied* DNS record in the Cloudflare zone, set as that zone's
# Custom Hostnames "Fallback Origin" (SSL/TLS → Custom Hostnames), itself
# CNAMEd onto the public-site Railway service's own generated domain.
CLOUDFLARE_FALLBACK_CNAME_TARGET=

# The platform's own root domain — every tenant's default site lives at
# {subdomain}.PLATFORM_ROOT_DOMAIN. /v1/public/* endpoints use this to tell
# a platform subdomain apart from a customer's verified custom domain when
# resolving the incoming Host header to a tenant (see resolve_public_tenant,
# migration 0013, and apps/api/src/lib/tenant/resolve-public-tenant.ts).
PLATFORM_ROOT_DOMAIN=sbaah.app

# Cloudflare Turnstile — captcha on the public inquiry form (PRODUCT_SPEC
# sections 4 and 10), verified server-side in POST /v1/public/leads.
# Create a Turnstile widget at https://dash.cloudflare.com/?to=/:account/turnstile
# to get this. The matching public *site key* belongs to public-site
# (apps/public-site/.env.example), not here.
TURNSTILE_SECRET_KEY=

# Number of trusted proxy hops that append to X-Forwarded-For in front of
# this service (lib/http/client-ip.ts). Railway's edge alone is 1 (default).
# Set to 2 if the API domain is also proxied through Cloudflare. Rate limits
# key on this address, so a wrong value either shares one limit across
# visitors (too high a hop count) or lets clients spoof it (too low).
TRUSTED_PROXY_HOPS=1

# Google Analytics — tenant "Apps" integration (read-only analytics scope).
# OAuth client from Google Cloud Console; the redirect URI must be
# registered on that client and point at
# {API_URL}/v1/integrations/google-analytics/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ANALYTICS_REDIRECT_URI=
# Encrypts stored Google refresh tokens (AES-256-GCM). 32 random bytes,
# base64: `openssl rand -base64 32`. Rotating it invalidates stored
# connections (tenants must reconnect).
GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=

# Google Analytics — platform (console) connection, optional separate client.
# Redirect URI: {API_URL}/v1/console/analytics/google/callback.
GOOGLE_PLATFORM_CLIENT_ID=
GOOGLE_PLATFORM_CLIENT_SECRET=
GOOGLE_ANALYTICS_PLATFORM_REDIRECT_URI=
# console's own base URL (no trailing slash) — the platform Google callback
# redirects back here.
CONSOLE_APP_URL=
