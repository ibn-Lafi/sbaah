# Supabase — api is the only service with a direct connection (PRODUCT_SPEC section 7)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role: used ONLY for the narrow server-side paths that must run
# before a user JWT exists (pre-auth OTP send/verify, registration, password
# reset — see docs/OTP_FLOW.md) and for explicit console-triggered
# cross-tenant operations. Never expose this to dashboard/console/public-site
# directly.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback-only: manual JWT signing if the admin.generateLink + verifyOtp
# session-minting approach (docs/OTP_FLOW.md section 4) doesn't hold up
# against a real project. Not used unless that fallback is implemented.
SUPABASE_JWT_SECRET=

# Twilio Verify — OTP provider (PRODUCT_SPEC section 2), no fallback provider.
# TWILIO_VERIFY_SERVICE_SID comes from creating a Verify Service in the
# Twilio Console (Verify -> Services -> Create) with CodeLength=4 — see
# docs/OTP_FLOW.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Signs the short-lived (10 min) token that bridges a successful OTP verify
# to registration/reset-password (docs/OTP_FLOW.md sections 4-5). Generate
# with e.g. `openssl rand -base64 32` — any long random string, unrelated
# to SUPABASE_JWT_SECRET above.
AUTH_TEMP_TOKEN_SECRET=

# Resend — transactional email (PRODUCT_SPEC section 11)
RESEND_API_KEY=

# StreamPay — payment gateway (PRODUCT_SPEC section 2)
# Confirm exact credential names with StreamPay before wiring billing.
STREAMPAY_API_KEY=
STREAMPAY_WEBHOOK_SECRET=

# CORS allowlist for authenticated endpoints (PRODUCT_SPEC section 7)
# Comma-separated origins for dashboard and console. Public-site
# domains are NOT listed here — /public/* endpoints accept any origin.
API_CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# The hostname a customer's custom domain must CNAME to so public-site's
# Host-header routing (PRODUCT_SPEC section 10) resolves it — set once
# public-site's own Railway domain is known (task 42/42's deployment
# guide). Shown to customers as DNS setup instructions (section 4.3);
# doesn't affect routing itself, which public-site controls separately.
PUBLIC_SITE_CNAME_TARGET=sites.sbaah.app
