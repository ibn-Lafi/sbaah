# Supabase — api is the only service with a direct connection (PRODUCT_SPEC section 7)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role: used ONLY for the narrow server-side paths that must run
# before a user JWT exists (pre-auth OTP send/verify, registration, password
# reset — see docs/OTP_FLOW.md) and for explicit console-triggered
# cross-tenant operations. Never expose this to dashboard/console/public-site
# directly.
SUPABASE_SERVICE_ROLE_KEY=
# Fallback-only: manual JWT signing if the admin.generateLink + verifyOtp
# session-minting approach (docs/OTP_FLOW.md section 4) doesn't hold up
# against a real project. Not used unless that fallback is implemented.
SUPABASE_JWT_SECRET=

# Authentica — OTP SMS provider (PRODUCT_SPEC section 2), no fallback
# provider. Unlike Twilio Verify, Authentica does not generate the code
# itself — api generates it (lib/otp/generate-code.ts) and Authentica only
# delivers + stores it for the matching /verify-otp check. Get your key at
# https://portal.authentica.sa/applications/ — see docs/OTP_FLOW.md.
AUTHENTICA_API_KEY=
# Optional — a custom SMS template configured in the Authentica portal.
# Omit to use their default sender-name template.
AUTHENTICA_OTP_TEMPLATE_ID=

# Signs the short-lived (10 min) token that bridges a successful OTP verify
# to registration/reset-password (docs/OTP_FLOW.md sections 4-5). Generate
# with e.g. `openssl rand -base64 32` — any long random string, unrelated
# to SUPABASE_JWT_SECRET above.
AUTH_TEMP_TOKEN_SECRET=

# SNDR — transactional email (PRODUCT_SPEC section 11). Get your key from
# app.sndr.sh/settings/api-keys. SNDR_FROM_EMAIL must be an address on a
# domain verified in SNDR (app.sndr.sh domains) — used as the daily
# follow-up digest's From header (task 41/42). Team-invite email has no
# call site yet (invited members authenticate via OTP login instead, see
# team/invite/route.ts).
SNDR_API_KEY=
SNDR_FROM_EMAIL=

# Shared secret checked against the `X-Internal-Cron-Secret` header on
# POST /v1/internal/cron/daily-digest (task 41/42) — the only caller is
# Supabase's own pg_cron/pg_net job (supabase/migrations/0020_daily_digest_cron.sql),
# never a browser. Generate with e.g. `openssl rand -base64 32`; set the
# SAME value as the `app.settings.cron_secret` Postgres setting the
# migration reads from (see that migration's header comment).
INTERNAL_CRON_SECRET=

# StreamPay — payment gateway (PRODUCT_SPEC section 2)
# Confirm exact credential names with StreamPay before wiring billing.
STREAMPAY_API_KEY=
STREAMPAY_WEBHOOK_SECRET=

# CORS allowlist for authenticated endpoints (PRODUCT_SPEC section 7)
# Comma-separated origins for dashboard and console. Public-site
# domains are NOT listed here — /public/* endpoints accept any origin.
API_CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3003

# The hostname a customer's custom domain must CNAME to so public-site's
# Host-header routing (PRODUCT_SPEC section 10) resolves it — set once
# public-site's own Railway domain is known (task 42/42's deployment
# guide). Shown to customers as DNS setup instructions (section 4.3);
# doesn't affect routing itself, which public-site controls separately.
PUBLIC_SITE_CNAME_TARGET=sites.sbaah.app

# The platform's own root domain — every tenant's default site lives at
# {subdomain}.PLATFORM_ROOT_DOMAIN. /v1/public/* endpoints use this to tell
# a platform subdomain apart from a customer's verified custom domain when
# resolving the incoming Host header to a tenant (see resolve_public_tenant,
# migration 0013, and apps/api/src/lib/tenant/resolve-public-tenant.ts).
PLATFORM_ROOT_DOMAIN=sbaah.app

# Cloudflare Turnstile — captcha on the public inquiry form (PRODUCT_SPEC
# sections 4 and 10), verified server-side in POST /v1/public/leads.
# Create a Turnstile widget at https://dash.cloudflare.com/?to=/:account/turnstile
# to get this. The matching public *site key* belongs to public-site
# (apps/public-site/.env.example), not here.
TURNSTILE_SECRET_KEY=
