# Supabase Auth — console obtains its own session directly (PRODUCT_SPEC section 7).
# Access is authorized against platform_admins by `api`, never by users.role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `api` service base URL (versioned, PRODUCT_SPEC section 7)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
