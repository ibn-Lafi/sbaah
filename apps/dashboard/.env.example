# Supabase Auth — dashboard obtains its own session directly (PRODUCT_SPEC section 7),
# then attaches the JWT to every request it makes to `api`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The `api` service base URL (versioned, PRODUCT_SPEC section 7)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Root domain every tenant's subdomain is under ({subdomain}.<this>) — must
# match `api`'s own PLATFORM_ROOT_DOMAIN, shown to the Owner/Admin on the
# settings screen next to their subdomain.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=sbaah.app
