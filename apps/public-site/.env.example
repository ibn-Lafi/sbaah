# public-site has no authenticated Supabase session (visitors are anonymous).
# It calls `api`'s unauthenticated /public/* endpoints only (PRODUCT_SPEC section 10).
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Cloudflare Turnstile site key (public, safe to expose to the browser) —
# renders the inquiry form's captcha widget. Paired with TURNSTILE_SECRET_KEY
# on `api`, which does the actual server-side verification (task 22/42);
# the widget itself is wired into public-site's inquiry form later (task 34/42).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Root domain the mandatory سبعة badge (task 35/42, every client site's
# footer) links to — same variable/value as `dashboard`'s (task 30/42).
# Also what middleware.ts compares the incoming Host header against to
# decide "is this a tenant site, or سبعة's own marketing homepage?"
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=sbaah.app

# dashboard's own URL (no trailing slash) — the marketing homepage's
# "Log in" / "Create your account" links point here, since registration
# and login are dashboard's routes, not public-site's.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3002
